# Required: DeepSeek API key used only by the local credential proxy.
DEEPSEEK_API_KEY=

# Optional: enables the GLM worker and round-robin cheap-worker routing.
PGS_API_KEY=

# Required: canonical directory workers are allowed to inspect/edit.
QWEN_WORKSPACE_ROOT=/absolute/path/to/your/workspace

# Optional overrides. setup/start auto-detect these commands when omitted.
CODEX_BIN=
NODE_BIN=

# Optional resource guards for delegated builds. Defaults shown here match the
# built-in values; sizes are bytes and intervals are milliseconds.
WORKER_MIN_FREE_BYTES=12884901888
WORKER_DISK_CHECK_MS=5000
WORKER_TERMINATION_GRACE_MS=5000
WORKER_CARGO_DEBUG=0
